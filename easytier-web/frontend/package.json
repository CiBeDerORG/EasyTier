{
  "name": "easytier-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../frontend-lib build && vite",
    "build": "pnpm --dir ../frontend-lib build && pnpm build:ci",
    "build:ci": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:agent": "pnpm build && node --test tests/deploy-agents.test.mjs",
    "test:agent:integration": "node tests/deploy-agent-integration.mjs",
    "test:unit": "node --test --experimental-strip-types tests/network-space-unit.test.mjs tests/registered-map-topology.test.mjs tests/node-map-assets.test.mjs tests/globe-geometry.test.mjs",
    "test:network-space": "pnpm build && node --test tests/network-space.test.mjs",
    "test:browser": "pnpm build && node --test tests/dashboard.test.mjs tests/network-space.test.mjs",
    "test:e2e": "pnpm build && cargo build -p easytier-web --features embed && node --test tests/central-e2e.test.mjs"
  },
  "dependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.0",
    "@primeuix/themes": "^1.2.3",
    "axios": "^1.13.5",
    "easytier-frontend-lib": "workspace:*",
    "leaflet": "1.9.4",
    "primevue": "^4.3.9",
    "tailwindcss-primeui": "^0.3.4",
    "three": "^0.180.0",
    "ts-md5": "^1.3.1",
    "uuid": "^11.0.2",
    "vue": "^3.5.12",
    "vue-i18n": "^9.9.1",
    "vue-router": "4"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "4.3.9",
    "@types/leaflet": "1.9.20",
    "@types/node": "^22.8.6",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "autoprefixer": "^10.4.20",
    "playwright": "1.61.0",
    "postcss": "^8.4.47",
    "tailwindcss": "=3.4.17",
    "typescript": "~5.6.2",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.0.3",
    "vue-tsc": "^2.1.10"
  }
}

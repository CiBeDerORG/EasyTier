# Configure the same token in EasyTier Web > Automation Center > Settings.
# The executor is a separate image; choose an immutable sha-<commit> tag if desired.
AUTOMATION_EXECUTOR_IMAGE=ghcr.io/cibederorg/easytier-automation-executor:feat-automation-center
# Generate a private random token; the empty example intentionally cannot start.
AUTOMATION_TOKEN=
AUTOMATION_CALLBACK_URL=http://127.0.0.1:11211
AUTOMATION_BIND_IP=127.0.0.1
AUTOMATION_PORT=8766
AUTOMATION_MAX_RUNNING=2
AUTOMATION_MAX_PENDING=30
AUTOMATION_MAX_MEDIA_SESSIONS=10
AUTOMATION_MAX_MEDIA_STARTING=2
AUTOMATION_ICE_SERVERS=[]
AUTOMATION_TURN_URLS=[]
AUTOMATION_TURN_SECRET=
AUTOMATION_TURN_TTL_SECONDS=3600
